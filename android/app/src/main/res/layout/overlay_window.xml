<?xml version="1.0" encoding="utf-8"?>
<!-- 게임 위에 뜨는 창. 폭은 코드에서 창 자체에 잡아 준다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 제목줄 = 드래그 손잡이 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/overlay_title"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/turnBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/turn_none"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnLock"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="@string/btn_lock"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="@string/btn_collapse"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="@string/btn_close"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 분기(변형) 선택 칩 — 분기가 있는 빌드에서만 보인다 -->
        <HorizontalScrollView
            android:id="@+id/variantScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/variantRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="@string/btn_prev"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <Space
                android:layout_width="4dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="@string/btn_next"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <Space
                android:layout_width="4dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnAuto"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_auto"
                android:textColor="@color/text_main"
                android:textSize="12sp" />

            <Space
                android:layout_width="4dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnRegion"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_region"
                android:textColor="@color/text_main"
                android:textSize="12sp" />

            <Space
                android:layout_width="4dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnApp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_app"
                android:textColor="@color/text_main"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingTop="4dp"
            android:paddingEnd="2dp"
            android:text="@string/status_no_region"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
