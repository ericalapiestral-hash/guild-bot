# ── 디스코드 ──────────────────────────────
# 디스코드 개발자 포털 > Bot > Token
DISCORD_TOKEN=여기에_봇_토큰

# 디스코드 개발자 포털 > General Information > Application ID
CLIENT_ID=여기에_애플리케이션_ID

# 길드(서버) ID - 서버 우클릭 > ID 복사 (개발자 모드 필요)
GUILD_ID=여기에_서버_ID

# ── 길드 사이트 통계 API ──────────────────
# 비우면 기본값(sena-guild-search) 사용
# STATS_API_BASE=

# ── 노션 빌드 도감 ────────────────────────
# 1) https://app.notion.com/developers/connections 에서 내부 연결(Internal) 생성 → 토큰 복사
# 2) 도감 페이지에서 ••• → 연결(Connections) → 만든 연결 추가  ← 이걸 안 하면 404가 납니다
NOTION_TOKEN=여기에_노션_연결_토큰

# 도감 페이지 주소를 그대로 넣어도 되고, 32자리 ID만 넣어도 됩니다
NOTION_PAGE_ID=3ac73174ac3f809c9b6af4dfd5e54a95

# ── 읽어주기(TTS) ─────────────────────────
# ⚠️ 어느 방식이든 결과가 반드시 Ogg/Opus(48kHz)여야 합니다.
#    MP3·WAV면 변환기(ffmpeg)가 필요해져서 무료 호스팅 128MB에서 메모리가 터져요.

# ① 로컬 프로그램 실행 (TTS가 이 컴퓨터에 있을 때)
#    {{out}} — 봇이 임시 파일 경로를 넣어줍니다. 없으면 표준출력을 오디오로 받아요.
#    {{text}} — 문장을 인자로 넘길 때. 안 쓰면 표준입력으로 들어갑니다.
#    셸을 거치지 않아서 채팅에 명령어를 심어도 실행되지 않습니다.
# TTS_COMMAND=piper --model ko_KR.onnx --output_file {{out}}

# ② HTTP 요청 (TTS가 서버로 떠 있을 때)
# TTS_URL=http://localhost:5000/tts?text={{text}}
# TTS_METHOD=POST
# TTS_HEADERS={"Content-Type":"application/json"}
# TTS_BODY={"text":"{{text}}","format":"ogg_opus"}

# 공통 (선택)
# TTS_TIMEOUT=8000
# TTS_MAX_CHARS=150

# 턴 인식 API (오버레이용) — 포트를 넣으면 봇과 같이 뜬다. 비우면 안 띄운다.
# TURN_API_PORT=3000
# 아무나 못 부르게 하려면 (아스키만 — HTTP 헤더에 한글은 못 넣는다)
# TURN_API_TOKEN=change-me
